# Copy to .env and fill in. Real environment variables take precedence over .env.

# Google AI (Gemini API) key: https://aistudio.google.com/apikey
# GOOGLE_API_KEY is accepted as a fallback.
GEMINI_API_KEY=

# Optional model overrides (defaults in src/ai/google.rs)
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_EMBED_MODEL=gemini-embedding-2

# Optional: seconds between model calls (default 5, fits the 15 RPM free tier)
# GEMINI_SECS_PER_CALL=5
